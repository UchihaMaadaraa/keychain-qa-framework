# Copy to .env (gitignored) or export in the shell. Every value is optional.
# Playwright CLI flags (--workers, --retries, --headed) override these.

BASE_URL=https://automationexercise.com   # system under test
WORKERS=2                                 # parallel test processes
RETRIES=0                                 # max 2; a pass-on-retry is reported as flaky
HEADLESS=true                             # false to watch the browser
