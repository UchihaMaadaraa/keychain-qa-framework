{
  "name": "keychain-qa-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic-first Playwright + TypeScript test framework for automationexercise.com",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed --workers=1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
